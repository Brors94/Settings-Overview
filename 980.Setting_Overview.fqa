{"name":"980.Setting Overview ","type":"com.fibaro.multilevelSensor","apiVersion":"1.3","initialProperties":{"viewLayout":{"$jason":{"body":{"header":{"style":{"height":"0"},"title":"quickApp_device_893"},"sections":{"items":[{"components":[{"name":"info_cpu","style":{"weight":"1.2"},"text":"info_cpu","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"components":[{"name":"update","style":{"weight":"0.50"},"text":"Update","type":"switch","value":"false","visible":true},{"name":"button_ID_8_2","style":{"weight":"0.50"},"text":" ","type":"button","visible":false}],"style":{"weight":"1.2"},"type":"horizontal"},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_zwave","style":{"weight":"1.2"},"text":"info_zwave","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_deaddevices","style":{"weight":"1.2"},"text":"info_deaddevices","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_localaccess","style":{"weight":"1.2"},"text":"info_localaccess","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"Info","style":{"weight":"1.2"},"text":"Info","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"max":"100","min":"0","name":"led_brightness","style":{"weight":"1.2"},"text":"","type":"slider","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_users","style":{"weight":"1.2"},"text":"info_users","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_installer","style":{"weight":"1.2"},"text":"info_installer","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"installer_access24h","style":{"weight":"1.2"},"text":"Grant Installer Access 24h","type":"switch","value":"false","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"space","style":{"weight":"1.2"},"text":"space","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_language","style":{"weight":"1.2"},"text":"info_language","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"components":[{"name":"language_save","style":{"weight":"0.50"},"text":"language_save","type":"switch","value":"false","visible":true},{"name":"button_ID_12_2","style":{"weight":"0.50"},"text":" ","type":"switch","value":"false","visible":false}],"style":{"weight":"1.2"},"type":"horizontal"},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"language_select","options":[],"selectionType":"single","style":{"weight":"1.2"},"text":"language_select","type":"select","values":[],"visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_Update","style":{"weight":"1.2"},"text":"info_Update","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"components":[{"name":"Auto_Update","style":{"weight":"0.50"},"text":"Auto_Update","type":"switch","value":"false","visible":true},{"name":"button_ID_17_2","style":{"weight":"0.50"},"text":" ","type":"button","visible":false}],"style":{"weight":"1.2"},"type":"horizontal"},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"components":[{"name":"Update_Now","style":{"weight":"0.50"},"text":"Update_Now","type":"switch","value":"false","visible":true},{"name":"Check_Update","style":{"weight":"0.50"},"text":"Check_Update","type":"switch","value":"false","visible":true}],"style":{"weight":"1.2"},"type":"horizontal"},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"space2","style":{"weight":"1.2"},"text":"space2","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"}]}},"head":{"title":"quickApp_device_893"}}},"uiView":[{"components":[{"name":"info_cpu","style":{"weight":"1.0"},"text":"info_cpu","type":"label","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onLongPressDown":[{"params":{"actionName":"UIAction","args":["onLongPressDown","update","$event.value"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","update","$event.value"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","update","$event.value"]},"type":"deviceAction"}]},"name":"update","style":{"weight":"0.50"},"text":"Update","type":"switch","value":"false","visible":true},{"eventBinding":{"onLongPressDown":[{"params":{"actionName":"UIAction","args":["onLongPressDown","button_ID_8_2"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","button_ID_8_2"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","button_ID_8_2"]},"type":"deviceAction"}]},"name":"button_ID_8_2","style":{"weight":"0.50"},"text":" ","type":"button","visible":false}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"name":"info_zwave","style":{"weight":"1.0"},"text":"